{
  "permissions": {
    "additionalDirectories": ["{{REPO}}"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"{{CLAUDE_HOME}}\\hooks\\session-git-context.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\collecteur-agents.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\guardrail.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\garde-push.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\guardrail.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\guardrail.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"{{CLAUDE_HOME}}\\hooks\\post-write-lint.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\collecteur-agents.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}\\hooks\\statusline.py\""
  },
  "env": {
    "OTEL_RESOURCE_ATTRIBUTES": "machine=windows"
  }
}
