# Cinq dossiers de ~/.claude sont des liens vers ce repo : ce que Claude Code y
# écrit à l'exécution (cache de skills, bytecode Python des hooks) atterrit ici.
# D'où un deny-all : rien n'entre dans le repo sans figurer dans cette liste.

/*

!/.gitignore
!/.gitattributes
!/.claude-plugin/
!/README.md
!/LICENSE
!/CLAUDE.md
!/HOOKS.md
!/DEPENDANCES.md
!/CAVEMAN.md
!/agents/
!/commands/
!/skills/
!/hooks/
!/mods/
!/git-hooks/
!/scripts/
!/exemple-perso/
!/settings.base.json
!/settings.windows.json
!/settings.macos.json
!/install.ps1
!/install.sh

# ~/.claude/skills est un lien vers skills/ : le cache du harness, sa corbeille
# et les skills qu'un outil tiers installe y atterrissent. Même deny-all : une
# skill du repo n'entre qu'en figurant ici.
/skills/*
!/skills/audit-seo/
!/skills/auditer-un-depot/
!/skills/avant-d-automatiser/
!/skills/cadrer-un-projet/
!/skills/cadrer-un-visuel/
!/skills/challenger-un-cadrage/
!/skills/deleguer/
!/skills/regles-dev-tester/
!/skills/systematic-debugging/
!/skills/traiter-une-review/
!/skills/verifier-avant-d-annoncer/

# Les déclarations de types que Claude Code écrit à côté d'un mod quand il le charge.
/mods/*/.claude-plugin/types/
/mods/*/tsconfig.json

# Bytecode Python des hooks et des scripts
__pycache__/
*.pyc
