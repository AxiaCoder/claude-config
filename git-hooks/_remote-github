# Bibliothèque sourcée (`. git-hooks/_remote-github`) par pre-push et _garde-public :
# reconnaît un remote GitHub d'après son URL.
#
# Remote GitHub : hôte github.com, www.github.com ou ssh.github.com, ou alias SSH que `ssh -G`
# résout vers l'un d'eux.

# Sortie 0 si l'hôte $1, en minuscules, est un hôte GitHub ; 1 sinon.
est_hote_github() {
	case "$1" in
	github.com | www.github.com | ssh.github.com) return 0 ;;
	*) return 1 ;;
	esac
}

# Affiche « hôte chemin » d'après l'URL $1 (forme schéma://[user@]hôte[:port]/chemin ou
# [user@]hôte:chemin), puis « ssh » ou « autre » selon que l'hôte peut être un alias SSH ;
# sortie 1 pour un chemin local.
hote_et_chemin() {
	case "$1" in
	ssh://* | git+ssh://* | ssh+git://*)
		reste=${1#*://}
		printf '%s %s ssh\n' "${reste%%/*}" "${reste#*/}"
		;;
	*://*)
		reste=${1#*://}
		printf '%s %s autre\n' "${reste%%/*}" "${reste#*/}"
		;;
	/* | ./* | ../*) return 1 ;;
	*:*)
		avant=${1%%:*}
		case "$avant" in */*) return 1 ;; esac
		printf '%s %s ssh\n' "$avant" "${1#*:}"
		;;
	*) return 1 ;;
	esac
}

# Affiche « owner/repo » du dépôt GitHub que vise l'URL de remote $1, sans « .git » ni
# barres obliques en bord ; sortie 1, sans rien afficher, si le remote n'est pas GitHub.
depot_github() {
	ligne=$(hote_et_chemin "$1") || return 1
	genre=${ligne##* }
	chemin=${ligne#* }
	chemin=${chemin% *}
	hote=${ligne%% *}
	hote=${hote##*@}
	hote=$(printf '%s' "${hote%%:*}" | tr 'A-Z' 'a-z')
	if ! est_hote_github "$hote"; then
		[ "$genre" = ssh ] || return 1
		case "$hote" in -*) return 1 ;; esac
		reel=$(ssh -G "$hote" 2>/dev/null | awk '$1 == "hostname" { print tolower($2); exit }')
		est_hote_github "$reel" || return 1
	fi
	printf '%s\n' "$chemin" | sed -e 's#^/*##' -e 's#/*$##' -e 's#\.git$##'
}
