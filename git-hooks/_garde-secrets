#!/bin/sh
# Garde « secrets », lancé par git-hooks/pre-commit et par git-hooks/pre-push avant le relais.
#
# Sans argument (pre-commit) : examine ce qui est indexé.
# « --push <remote> » (pre-push) : lit l'entrée du pre-push sur stdin et examine, pour chaque
# ref poussée, chaque commit qui part — le pre-commit ne voit pas les commits créés par
# `rebase --continue`, `cherry-pick` ou `commit-tree`. Plage par ref : sha distant connu →
# distant..local ; nouvelle branche → merge-base avec la branche par défaut du remote, sinon
# les commits absents de tout remote (`--not --remotes`). Suppression de ref ignorée.
#
# Sort en 1 si betterleaks trouve un secret, s'il est absent de ~/.claude/bin, ou si son
# analyse échoue ; en 0 sinon, hors dépôt git ou sans rien à examiner, ou quand
# l'installation a été faite sans externes (~/.claude/claude-config.sans-externes, une
# ligne sur stderr).
#
# betterleaks est installé à version fixée par install.sh / install.ps1
# (git-hooks/betterleaks.version). La validation des secrets auprès des API est coupée
# (--validation=false) : le garde ne fait aucun appel réseau. Le rapport donne
# fichier:ligne, la règle et, au pre-push, le commit — jamais le secret (--redact,
# gabarit _garde-secrets.tmpl).
#
# La config est fixée par _garde-secrets.toml (--config) et la liste d'empreintes ignorées
# par _garde-secrets.ignore, vide (--gitleaks-ignore-path) ; la cible passée à betterleaks
# est un dossier vide, le dépôt lui étant désigné par GIT_DIR / GIT_WORK_TREE. Un
# .gitleaks.toml, un .betterleaks.toml, un .gitleaksignore ou un .betterleaksignore du
# dépôt sont donc sans effet, et les variables GITLEAKS_* / BETTERLEAKS_* sont retirées de
# l'environnement.
#
# Exempter une ligne (faux positif confirmé par l'utilisateur) : un commentaire
# « gitleaks:allow » sur la ligne.
#
# Contournement ponctuel :
#   ALLOW_COMMIT_SECRET=1 git commit …
#   ALLOW_COMMIT_SECRET=1 git push …

for variable in $(env | grep -oE '^(GITLEAKS|BETTERLEAKS)_[A-Za-z0-9_]*='); do
	unset "${variable%=}"
done

Z=0000000000000000000000000000000000000000

if [ "${1:-}" = "--push" ]; then
	mode=push
	remote_nom=${2:-}
	etape=pre-push
	acte=Push
	geste="git push"
else
	mode=commit
	etape=pre-commit
	acte=Commit
	geste="git commit"
fi

git rev-parse --git-dir >/dev/null 2>&1 || exit 0

# Affiche le sha de la branche par défaut du remote suivie localement, rien sinon.
branche_defaut() {
	for ref in "refs/remotes/$remote_nom/HEAD" "refs/remotes/$remote_nom/main" "refs/remotes/$remote_nom/master"; do
		git rev-parse -q --verify "$ref^{commit}" 2>/dev/null && return 0
	done
	return 1
}

# Affiche, une par ligne, la plage git log de chaque ref de l'entrée du pre-push (stdin).
plages_poussees() {
	while read -r _ref_locale sha_local _ref_distante sha_distant; do
		[ -n "$sha_local" ] && [ "$sha_local" != "$Z" ] || continue
		commit=$(git rev-parse -q --verify "$sha_local^{commit}" 2>/dev/null) || continue
		if [ -n "$sha_distant" ] && [ "$sha_distant" != "$Z" ] && git cat-file -e "$sha_distant^{commit}" 2>/dev/null; then
			echo "$sha_distant..$commit"
		elif defaut=$(branche_defaut) && base=$(git merge-base "$defaut" "$commit" 2>/dev/null); then
			echo "$base..$commit"
		else
			echo "$commit --not --remotes"
		fi
	done
}

if [ "$mode" = push ]; then
	plages=$(plages_poussees)
	[ -n "$plages" ] || exit 0
else
	git diff --cached --quiet 2>/dev/null && exit 0
fi

if [ -f "$HOME/.claude/claude-config.sans-externes" ]; then
	echo "$etape : garde secrets désactivé à l'installation (--sans-externes)." >&2
	exit 0
fi

if [ "${ALLOW_COMMIT_SECRET:-}" = "1" ]; then
	echo "$etape : garde secrets non appliqué (ALLOW_COMMIT_SECRET=1)." >&2
	exit 0
fi

binaire="$HOME/.claude/bin/betterleaks"
[ -f "$binaire.exe" ] && binaire="$binaire.exe"
if [ ! -x "$binaire" ]; then
	cat >&2 <<MSG

  ⛔  $acte refusé : garde secrets inactif, betterleaks est absent ($binaire).

  Relancer l'installation de claude-config, qui le pose à la version fixée :
    bash install.sh        (macOS, Linux)
    .\\install.ps1          (Windows)

  S'en passer, sans rien télécharger : install.sh --sans-externes, install.ps1 -SansExternes.

  Contournement ponctuel :
    ALLOW_COMMIT_SECRET=1 $geste …

MSG
	exit 1
fi

ici=$(dirname "$0")
GIT_DIR=$(git rev-parse --absolute-git-dir)
export GIT_DIR
if arbre=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$arbre" ]; then
	GIT_WORK_TREE=$arbre
	export GIT_WORK_TREE
fi
case ${GIT_INDEX_FILE:-} in
"" | /* | [A-Za-z]:*) ;;
*) GIT_INDEX_FILE="$(pwd -P)/$GIT_INDEX_FILE" ;;
esac
cible_vide=$(mktemp -d)
trap 'rmdir "$cible_vide"' EXIT

# Lance betterleaks sur le dépôt avec les options fixes du garde, précédées de $@.
# Sortie de betterleaks : 0 rien trouvé, 3 secret trouvé, autre code échec.
analyse() {
	"$binaire" git "$@" --validation=false --redact \
		--config="$ici/_garde-secrets.toml" --gitleaks-ignore-path="$ici/_garde-secrets.ignore" \
		--no-banner --no-color --log-level=error --exit-code=3 \
		--report-format=template --report-template="$ici/_garde-secrets.tmpl" --report-path=- "$cible_vide" 2>&1
}

if [ "$mode" = push ]; then
	sortie=
	code=0
	while IFS= read -r plage; do
		morceau=$(analyse --log-opts="$plage")
		resultat=$?
		[ -n "$morceau" ] && sortie="${sortie:+$sortie
}$morceau"
		case $resultat in
		0) ;;
		3) [ "$code" = 0 ] && code=3 ;;
		*) code=$resultat ;;
		esac
	done <<PLAGES
$plages
PLAGES
else
	sortie=$(analyse --pre-commit --staged)
	code=$?
fi

case $code in
0) exit 0 ;;
3)
	{
		echo
		if [ "$mode" = push ]; then
			echo "  ⛔  Push refusé : secret détecté dans un commit qui part (betterleaks, secrets masqués)."
		else
			echo "  ⛔  Commit refusé : secret détecté dans l'indexé (betterleaks, secrets masqués)."
		fi
		echo
		printf '%s\n' "$sortie"
		echo
		if [ "$mode" = push ]; then
			echo "  Chaque commit qui part est examiné : un commit correctif ne suffit pas."
			echo "  Retirer le secret de l'historique (git commit --amend, git rebase -i), puis repousser."
			echo
		fi
		echo "  Faux positif confirmé par l'utilisateur : l'exempter par un commentaire"
		echo "  « gitleaks:allow » sur la ligne."
		echo
		echo "  Contournement ponctuel :"
		echo "    ALLOW_COMMIT_SECRET=1 $geste …"
		echo
	} >&2
	;;
*)
	{
		echo
		echo "  ⛔  $acte refusé : l'analyse de betterleaks a échoué (code $code)."
		echo
		printf '%s\n' "$sortie" | sed 's/^/    /'
		echo
		echo "  Contournement ponctuel :"
		echo "    ALLOW_COMMIT_SECRET=1 $geste …"
		echo
	} >&2
	;;
esac
exit 1
