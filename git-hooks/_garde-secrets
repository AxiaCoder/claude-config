#!/bin/sh
# Garde « secrets » du pre-commit, lancé par git-hooks/pre-commit avant le relais.
# Sort en 1 si betterleaks trouve un secret dans ce qui est indexé, s'il est absent de
# ~/.claude/bin, ou si son analyse échoue ; en 0 sinon, hors dépôt git ou sans rien
# d'indexé, ou quand l'installation a été faite sans externes
# (~/.claude/claude-config.sans-externes, une ligne sur stderr).
#
# betterleaks est installé à version fixée par install.sh / install.ps1
# (git-hooks/betterleaks.version). La validation des secrets auprès des API est coupée
# (--validation=false) : le garde ne fait aucun appel réseau. Le rapport donne
# fichier:ligne et la règle, jamais le secret (--redact, gabarit _garde-secrets.tmpl).
#
# La config est fixée par _garde-secrets.toml (--config) et la liste d'empreintes ignorées
# par _garde-secrets.ignore, vide (--gitleaks-ignore-path) ; la cible passée à betterleaks
# est un dossier vide, le dépôt lui étant désigné par GIT_DIR / GIT_WORK_TREE. Un
# .gitleaks.toml, un .betterleaks.toml, un .gitleaksignore ou un .betterleaksignore du
# dépôt sont donc sans effet, et les variables GITLEAKS_* / BETTERLEAKS_* sont retirées de
# l'environnement.
#
# Exempter une ligne (faux positif confirmé par l'utilisateur) : un commentaire
# « gitleaks:allow » sur la ligne.
#
# Contournement ponctuel :
#   ALLOW_COMMIT_SECRET=1 git commit …

for variable in $(env | grep -oE '^(GITLEAKS|BETTERLEAKS)_[A-Za-z0-9_]*='); do
	unset "${variable%=}"
done

git rev-parse --git-dir >/dev/null 2>&1 || exit 0
git diff --cached --quiet 2>/dev/null && exit 0

if [ -f "$HOME/.claude/claude-config.sans-externes" ]; then
	echo "pre-commit : garde secrets désactivé à l'installation (--sans-externes)." >&2
	exit 0
fi

if [ "${ALLOW_COMMIT_SECRET:-}" = "1" ]; then
	echo "pre-commit : garde secrets non appliqué (ALLOW_COMMIT_SECRET=1)." >&2
	exit 0
fi

binaire="$HOME/.claude/bin/betterleaks"
[ -f "$binaire.exe" ] && binaire="$binaire.exe"
if [ ! -x "$binaire" ]; then
	cat >&2 <<MSG

  ⛔  Commit refusé : garde secrets inactif, betterleaks est absent ($binaire).

  Relancer l'installation de claude-config, qui le pose à la version fixée :
    bash install.sh        (macOS, Linux)
    .\\install.ps1          (Windows)

  S'en passer, sans rien télécharger : install.sh --sans-externes, install.ps1 -SansExternes.

  Contournement ponctuel :
    ALLOW_COMMIT_SECRET=1 git commit …

MSG
	exit 1
fi

ici=$(dirname "$0")
depot_git=$(git rev-parse --absolute-git-dir)
arbre=$(git rev-parse --show-toplevel)
case ${GIT_INDEX_FILE:-} in
"" | /* | [A-Za-z]:*) ;;
*) GIT_INDEX_FILE="$(pwd -P)/$GIT_INDEX_FILE" ;;
esac
cible_vide=$(mktemp -d)
trap 'rmdir "$cible_vide"' EXIT
sortie=$(GIT_DIR="$depot_git" GIT_WORK_TREE="$arbre" "$binaire" git --pre-commit --staged --validation=false --redact \
	--config="$ici/_garde-secrets.toml" --gitleaks-ignore-path="$ici/_garde-secrets.ignore" \
	--no-banner --no-color --log-level=error --exit-code=3 \
	--report-format=template --report-template="$ici/_garde-secrets.tmpl" --report-path=- "$cible_vide" 2>&1)
code=$?

case $code in
0) exit 0 ;;
3)
	{
		echo
		echo "  ⛔  Commit refusé : secret détecté dans l'indexé (betterleaks, secrets masqués)."
		echo
		printf '%s\n' "$sortie"
		echo
		echo "  Faux positif confirmé par l'utilisateur : l'exempter par un commentaire"
		echo "  « gitleaks:allow » sur la ligne."
		echo
		echo "  Contournement ponctuel :"
		echo "    ALLOW_COMMIT_SECRET=1 git commit …"
		echo
	} >&2
	;;
*)
	{
		echo
		echo "  ⛔  Commit refusé : l'analyse de betterleaks a échoué (code $code)."
		echo
		printf '%s\n' "$sortie" | sed 's/^/    /'
		echo
		echo "  Contournement ponctuel :"
		echo "    ALLOW_COMMIT_SECRET=1 git commit …"
		echo
	} >&2
	;;
esac
exit 1
